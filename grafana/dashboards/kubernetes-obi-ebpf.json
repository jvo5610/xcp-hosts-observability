          "editorMode": "code",
          "expr": "sum by(cluster,k8s_namespace_name,service_name,http_response_status_code) (rate(http_server_request_duration_seconds_count{cluster=~\"$cluster\",k8s_namespace_name=~\"$namespace\"}[5m]))",
          "legendFormat": "{{cluster}} / {{k8s_namespace_name}} / {{service_name}} / {{http_response_status_code}}",
          "range": true,
          "instant": false,
          "refId": "A",
