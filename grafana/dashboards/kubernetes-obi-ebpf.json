{
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "willow",
    "otel",
    "grafana-cloud",
    "kubernetes"
  ],
  "editable": true,
  "annotations": {
    "list": []
  },
  "uid": "willow-k8s-obi-ebpf",
  "title": "Willow Kubernetes OBI eBPF",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "refresh": 1,
        "query": {
          "query": "label_values(kube_node_info, cluster)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "sort": 1
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "refresh": 1,
        "query": {
          "query": "label_values(target_info{cluster=~\"$cluster\"}, k8s_namespace_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "multi": true,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "OBI targets",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "count by(cluster,k8s_namespace_name) (target_info{cluster=~\"$cluster\",k8s_namespace_name=~\"$namespace\"})",
          "legendFormat": "{{cluster}} / {{k8s_namespace_name}}",
          "range": false,
          "instant": true,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "HTTP RPS",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "sum by(cluster,k8s_namespace_name,service_name,http_request_method) (rate(http_server_request_duration_seconds_count{cluster=~\"$cluster\",k8s_namespace_name=~\"$namespace\"}[5m]))",
          "legendFormat": "{{cluster}} / {{k8s_namespace_name}} / {{service_name}} / {{http_request_method}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafanacloud-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafanacloud-prom"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by(cluster,k8s_namespace_name,service_name,le) (rate(http_server_request_duration_seconds_bucket{cluster=~\"$cluster\",k8s_namespace_name=~\"$namespace\"}[5m])))",
          "legendFormat": "{{cluster}} / {{k8s_namespace_name}} / {{service_name}}",
          "range": true,
          "instant": false,
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "HTTP status rate",
      "type": "timeseries",
      "datasource": {
